# ==============================================================================
# Enterprise Intelligence Platform - Configuration Example
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Enterprise Intelligence Platform"
API_V1_STR=/api/v1
SECRET_KEY=replace_with_a_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
# For local Docker: postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_intel
# For Neon / Hosted PostgreSQL: postgresql+psycopg2://user:password@ep-host-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/enterprise_intel

# DIRECT_URL: direct connection for Alembic migrations (without -pooler)
DIRECT_URL=
TEST_DATABASE_URL=sqlite:///./test.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# LLM Providers Configuration
# Groq: ultra-low-latency Llama-3 inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini: high-context reasoning fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Fallback Routing Policy
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=gemini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=25

# RAG & Retrieval Engine
RRF_K=60
TOP_K_VECTOR=10
TOP_K_KEYWORD=10
TOP_K_FINAL=8
MIN_RELEVANCE_SCORE=0.35

# Security & Prompt Injection Defense
PROMPT_INJECTION_PROTECTION_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123!
CORS_ORIGINS=["*"]
